Spans
| where Operation == "chat"
| summarize LLMCalls = count(), MeanMs = avg(DurationMs), P95Ms = percentile(DurationMs, 95),
    SpansMissingDuration = countif(isnull(DurationMs))
    by bin(TimeGenerated, 5m)
| project TimeGenerated, LLMCalls, MeanMs, P95Ms, SpansMissingDuration
| order by TimeGenerated asc
