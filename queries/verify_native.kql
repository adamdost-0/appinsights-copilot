// Native tables only. Missing tables remain errors, never fabricated empty rows.
// Schema: https://learn.microsoft.com/azure/azure-monitor/reference/tables/otelspans
let run_id = __RUN_ID__;
let resource_id = __RESOURCE_ID__;
let scenario = __SCENARIO__;
let cli_version = __VERSION__;
let start_time = datetime(__START__);
let finish_time = datetime(__FINISH__);
let WindowSpans = materialize(
    OTelSpans
    | where TimeGenerated between (start_time .. finish_time)
    | where _ResourceId =~ resource_id);
// Resource metadata may arrive after span completion; bound its lookup by the
// IDs of the time-scoped application spans, not by the metadata arrival time.
let Resources =
    OTelResources
    | where _ResourceId =~ resource_id
    | where Id in (WindowSpans | project ResourceAttributesId)
    | summarize arg_max(TimeGenerated, Attributes) by Id
    | project ResourceAttributesId = Id, JoinedResourceAttributes = Attributes;
let RunSpans = materialize(
    WindowSpans
    | join kind=leftouter Resources on ResourceAttributesId
    | extend ResourceAttributes = bag_merge(
        coalesce(ResourceAttributes, dynamic({})), coalesce(JoinedResourceAttributes, dynamic({})))
    | where tostring(ResourceAttributes["copilot.run.id"]) == run_id
    | where tostring(ResourceAttributes["copilot.audit.scenario"]) == scenario
    | where tostring(ResourceAttributes["service.name"]) == "github-copilot"
        and tostring(ResourceAttributes["service.version"]) == cli_version
    | project Table = "OTelSpans", Name, Kind, StatusCode, Success, TraceId, SpanId,
        ParentSpanId, Attributes, ResourceAttributes, _ResourceId,
        TimeGenerated, EndTime, DurationMs);
union
    (RunSpans),
    (OTelEvents
    | where TimeGenerated between (start_time .. finish_time)
    | where _ResourceId =~ resource_id
    | join kind=inner (
        RunSpans
        | summarize SpanResourceAttributes = take_any(ResourceAttributes) by TraceId, SpanId
    ) on TraceId, SpanId
    | extend ResourceAttributes = bag_merge(
        coalesce(ResourceAttributes, dynamic({})), SpanResourceAttributes)
    | project Table = "OTelEvents", Name, Kind = "", StatusCode = "", Success = bool(null),
        TraceId, SpanId, ParentSpanId = "", Attributes, ResourceAttributes, _ResourceId,
        TimeGenerated, EndTime = datetime(null), DurationMs = real(null))
| take __ROW_LIMIT__
