// Shared by every panel; braces are literal KQL, not Python format placeholders.
let selected_conversation = base64_decode_tostring('{ConversationId:base64}');
let selected_run = base64_decode_tostring('{RunId:base64}');
let selected_trace = base64_decode_tostring('{TraceId:base64}');
let WindowSpans = materialize(
    OTelSpans
    | where TimeGenerated between (ago(24h) .. now())
    | where TimeGenerated {TimeRange}
    | where _ResourceId == ""
    | summarize arg_max(TimeGenerated, *) by TraceId, SpanId);
let Resources =
    OTelResources
    | where _ResourceId == ""
    | where isnotempty(Id)
    | where Id in (WindowSpans | project ResourceAttributesId)
    | summarize arg_max(TimeGenerated, Attributes) by Id
    | project ResourceAttributesId = Id, JoinedResourceAttributes = Attributes;
let Spans = materialize(
    WindowSpans
    | join kind=leftouter Resources on ResourceAttributesId
    | extend ResourceAttributes = bag_merge(
        coalesce(ResourceAttributes, dynamic({})), coalesce(JoinedResourceAttributes, dynamic({})))
    | where tostring(ResourceAttributes["service.name"]) == "github-copilot"
    | extend RunId = tostring(ResourceAttributes["copilot.run.id"]),
        ConversationId = tostring(Attributes["gen_ai.conversation.id"]),
        Scenario = tostring(ResourceAttributes["copilot.audit.scenario"]),
        Operation = tostring(Attributes["gen_ai.operation.name"])
    | where isempty(selected_conversation) or ConversationId == selected_conversation
    | where isempty(selected_run) or RunId == selected_run
    | where isempty(selected_trace) or TraceId == selected_trace
    | extend Model = coalesce(tostring(Attributes["gen_ai.response.model"]),
                               tostring(Attributes["gen_ai.request.model"]), "(not recorded)"),
        ToolName = tostring(Attributes["gen_ai.tool.name"]),
        ToolType = tostring(Attributes["gen_ai.tool.type"]),
        InputTokens = iff(Operation == "chat", tolong(Attributes["gen_ai.usage.input_tokens"]), long(null)),
        OutputTokens = iff(Operation == "chat", tolong(Attributes["gen_ai.usage.output_tokens"]), long(null)),
        Failed = coalesce(Success == false, false) or StatusCode in~ ("error", "2", "STATUS_CODE_ERROR")
    | extend DurationMs = iff(isfinite(todouble(DurationMs)) and todouble(DurationMs) >= 0,
                              todouble(DurationMs), real(null)),
        EndTime = iff(EndTime >= TimeGenerated, EndTime, datetime(null))
    | project TimeGenerated, EndTime, DurationMs, TraceId, SpanId, ParentSpanId,
        RunId, ConversationId, Scenario, Operation, Model, ToolName, ToolType,
        InputTokens, OutputTokens, StatusCode, Success, Failed);
